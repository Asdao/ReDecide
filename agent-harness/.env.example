# Copy to .env for local development. Never commit a real .env file.
# Deployment environment variables take precedence over this file.

DEEPSEEK_API_KEY=
HARNESS_MODEL_PROVIDER=deepseek
HARNESS_MODEL=deepseek-v4-pro
HARNESS_MODEL_BASE_URL=https://api.deepseek.com

# Optional aliases/overrides:
# HARNESS_MODEL_API_KEY=      # overrides DEEPSEEK_API_KEY
# HARNESS_ENV_FILE=C:/path/to/another.env
# HARNESS_CWD=C:/path/to/project
# HARNESS_BRIDGE=C:/path/to/agent_bridge.py
# HARNESS_PYTHON=python
