# Copy this file to .env for local development. Never commit real credentials.
# Deployment environment variables take precedence over values loaded from .env.

# Shared replay artifacts created after a native .dem upload.
REDECIDE_REPLAY_STORE=data/runtime/replays

# Comma-separated browser origins accepted by the unified FastAPI gateway.
REDECIDE_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional public Vercel Blob import. Leave disabled until the frontend's Blob
# upload is ready. Restart FastAPI after changing this value.
REDECIDE_BLOB_IMPORT_ENABLED=false
REDECIDE_BLOB_MAX_BYTES=1073741824

# Public FastAPI base URL embedded in the Next.js browser bundle. Copy this
# value into frontend/.env.local when running Next.js from frontend/.
# Never put provider credentials in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Used only when backend.replay_api.main is run as a standalone service.
REPLAY_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional live Pi/DeepSeek coaching configuration. Keep credentials blank in Git.
DEEPSEEK_API_KEY=
HARNESS_MODEL_PROVIDER=deepseek
HARNESS_MODEL=deepseek-v4-flash
HARNESS_MODEL_BASE_URL=https://api.deepseek.com
HARNESS_MODEL_API=openai-completions
HARNESS_MODEL_API_KEY=

# Optional local process overrides. Uncomment only when the defaults do not work.
# HARNESS_ENV_FILE=C:/path/to/another.env
# HARNESS_CWD=C:/path/to/project
# HARNESS_BRIDGE=C:/path/to/agent_bridge.py
# HARNESS_PYTHON=python
