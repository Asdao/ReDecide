# Copy this file to .env for local development. Never commit real credentials.
# Deployment environment variables take precedence over values loaded from .env.

# Shared replay artifacts created after a native .dem upload.
REDECIDE_REPLAY_STORE=data/runtime/replays
# Artifact persistence backend. Keep filesystem locally. Vercel Services
# automatically use Blob when vercel.json injects REDECIDE_BLOB_SERVICE_URL;
# set this to `filesystem` in Vercel only to opt out explicitly.
REDECIDE_STORAGE_BACKEND=filesystem
REDECIDE_BLOB_ACCESS=public
REDECIDE_BLOB_REPLAY_PREFIX=replays
REDECIDE_BLOB_ANALYSIS_PREFIX=analysis

# Comma-separated browser origins accepted by the unified FastAPI gateway.
REDECIDE_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional public Vercel Blob import. The frontend supports this path when its
# upload mode is `blob`; the backend route remains disabled by default. Restart
# FastAPI after changing this value.
REDECIDE_BLOB_IMPORT_ENABLED=false
REDECIDE_BLOB_MAX_BYTES=1073741824

# Vercel Services routes /api to FastAPI on the same origin. For local Next.js
# development, copy this into frontend/.env.local and point it at standalone
# FastAPI. Leave it unset in Vercel.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Upload transport: `direct` locally, or `blob` when the Next.js Blob routes
# and a public Vercel Blob store are configured.
NEXT_PUBLIC_REPLAY_UPLOAD_MODE=direct

# Used only when backend.replay_api.main is run as a standalone service.
REPLAY_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional live DeepSeek coaching configuration. Keep credentials blank in Git.
# When a provider base URL and key are present, HTTP coaching is selected by
# default and does not require Node.js or agent-harness. Set REDECIDE_COACH_MODE=pi
# only when you explicitly want the legacy local Pi subprocess.
DEEPSEEK_API_KEY=
HARNESS_MODEL_PROVIDER=deepseek
HARNESS_MODEL=deepseek-v4-flash
HARNESS_MODEL_BASE_URL=https://api.deepseek.com
HARNESS_MODEL_API=openai-completions
HARNESS_MODEL_API_KEY=

# Optional explicit transport override. Leave blank for automatic selection.
# "http" forces the OpenAI-compatible HTTP adapter; "pi" forces the legacy
# agent-harness subprocess adapter.
REDECIDE_COACH_MODE=

# Number of outcome-blind moments coached for each selected player (1-10).
# The default is ten; lower this for faster/cheaper local runs.
REDECIDE_ANALYSES_PER_PLAYER=10

# Optional local process overrides. Uncomment only when the defaults do not work.
# HARNESS_ENV_FILE=C:/path/to/another.env
# HARNESS_CWD=C:/path/to/project
# HARNESS_BRIDGE=C:/path/to/agent_bridge.py
# HARNESS_PYTHON=python
