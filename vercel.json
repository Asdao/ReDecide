{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "REDECIDE_BLOB_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/blob/upload",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/blob/cleanup",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/service-internal/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
