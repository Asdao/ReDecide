__pycache__/
*.py[cod]
*.part
*.egg-info/
.env

# Local Python environments and test caches.
.venv/
.venv-wsl/
venv/
.pytest_cache/

# Node projects live under frontend/ and agent-harness/. Ignore dependency
# trees everywhere and accidental package-manager files created at repo root.
node_modules/
.pnpm-store/
/package.json
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Public metadata, map assets, manifests, schemas, and sanitized fixtures may
# be uploaded.  Raw demos, parsed replays, databases, features, and user
# uploads stay private and are ignored by Git.
data/private/
data/private/**
data/*
!data/public/
!data/public/**
model/artifacts/*.json
model/artifacts/*.txt

# Track only the empty RE:DECIDE data ownership skeleton.
!data/
data/*
!data/samples/
data/samples/*
!data/samples/.gitkeep
!data/eval/
data/eval/*
!data/eval/model/
data/eval/model/*
!data/eval/model/.gitkeep
!data/eval/human/
data/eval/human/*
!data/eval/human/.gitkeep

# Keep the deployable replay-value model bundle available to users after clone.
!Blackbox/model/artifacts/full_replay_value.txt
!Blackbox/model/artifacts/full_replay_value.txt.json
!Blackbox/model/artifacts/full_replay_value.manifest.json
!Blackbox/model/artifacts/full_replay_calibrator.json
!Blackbox/model/artifacts/small_snapshot_value.json
