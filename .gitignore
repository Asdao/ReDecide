__pycache__/
*.py[cod]
*.part
*.egg-info/
.env
# Public metadata, map assets, manifests, schemas, and sanitized fixtures may
# be uploaded.  Raw demos, parsed replays, databases, features, and user
# uploads stay private and are ignored by Git.
data/private/
data/private/**
data/*
!data/public/
!data/public/**
model/artifacts/*.json
model/artifacts/*.txt

# Track only the empty RE:DECIDE data ownership skeleton.
!data/
data/*
!data/samples/
data/samples/*
!data/samples/.gitkeep
!data/eval/
data/eval/*
!data/eval/model/
data/eval/model/*
!data/eval/model/.gitkeep
!data/eval/human/
data/eval/human/*
!data/eval/human/.gitkeep

# Keep the deployable replay-value model bundle available to users after clone.
!Noah/model/artifacts/full_replay_value.txt
!Noah/model/artifacts/full_replay_value.txt.json
!Noah/model/artifacts/full_replay_value.manifest.json
!Noah/model/artifacts/full_replay_calibrator.json
!Noah/model/artifacts/small_snapshot_value.json
