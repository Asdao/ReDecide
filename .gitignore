# Python-generated files, local environments, and test caches.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.venv-wsl/
venv/
*.part

# Local editor and IDE state.
.idea/

# Local secrets.
.env

# Node projects live under frontend/ and agent-harness/. Ignore dependency
# trees everywhere and accidental package-manager files created at repo root.
node_modules/
.pnpm-store/
/package.json
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Public metadata, map assets, manifests, schemas, and sanitized fixtures may
# be uploaded.  Raw demos, parsed replays, databases, features, and user
# uploads stay private and are ignored by Git.
data/private/
data/private/**
data/*
!data/public/
!data/public/**
model/artifacts/*.json
model/artifacts/*.txt

# Track the RE:DECIDE data ownership skeleton and reviewed public assets.
!data/
data/*
!data/public/
!data/public/**
!data/samples/
data/samples/*
!data/samples/.gitkeep
!data/eval/
data/eval/*
!data/eval/model/
data/eval/model/*
!data/eval/model/.gitkeep
!data/eval/human/
data/eval/human/*
!data/eval/human/.gitkeep

# Keep the deployable replay-value model bundle available to users after clone.
!backend/replay_engine/model/artifacts/full_replay_value.txt
!backend/replay_engine/model/artifacts/full_replay_value.txt.json
!backend/replay_engine/model/artifacts/full_replay_value.manifest.json
!backend/replay_engine/model/artifacts/full_replay_calibrator.json
!backend/replay_engine/model/artifacts/small_snapshot_value.json
.vercel
.env*
