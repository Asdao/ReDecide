# Local development uploads directly to FastAPI by default.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_REPLAY_UPLOAD_MODE=direct

# On Vercel, change the upload mode to "blob" and connect a public Blob store.
# Vercel creates BLOB_READ_WRITE_TOKEN automatically. Never add that token to a
# NEXT_PUBLIC_* variable or commit it to Git.
