# The Vercel Services backend is mounted at /backend on the same origin.
# For local development with FastAPI running on port 8000, use the URL below.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_REPLAY_UPLOAD_MODE=direct

# On Vercel, set NEXT_PUBLIC_BACKEND_URL=/backend (or let Services generate it),
# change the upload mode to "blob", and connect the Blob store. Blob's
# server-side credentials are managed by Vercel; never put them in a
# NEXT_PUBLIC_* variable or commit them to Git.
