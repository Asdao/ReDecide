# Vercel Services routes /api to FastAPI on the same origin, so this variable
# should be unset in Vercel. For local development with standalone FastAPI:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_REPLAY_UPLOAD_MODE=direct

# On Vercel, leave NEXT_PUBLIC_API_BASE_URL unset, change the upload mode to
# "blob", and connect the Blob store. Blob's server-side credentials are
# managed by Vercel; never put them in a NEXT_PUBLIC_* variable or commit them.
